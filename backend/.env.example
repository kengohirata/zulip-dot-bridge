# Portable Outgoing-webhook server. Documentation only; Python does not load this.
# Export values through a secure service manager; never commit populated copies.
# Create/use an Outgoing webhook bot, not the optional Generic-bot polling route.
ZULIP_REALM=https://your-organization.zulipchat.com
ZULIP_BOT_EMAIL=outgoing-bot@your-organization.zulipchat.com
# Resolve the actual numeric bot ID in an authenticated setup session.
ZULIP_BOT_ID=
BRIDGE_OWNER=
# Exact callback host(s) from the verified plugin event integration.
# No wildcard, URL, port, localhost or guessed hostname.
CALLBACK_HOSTS=
# Durable LOCAL storage. Do not run multiple processes, use :memory:, or use NFS.
DATABASE=state/bridge.sqlite3
# Fixed loopback bind; trusted TLS/authentication reverse proxy required.
PORT=8080
# Fail-closed operator gates. Validate setup before enabling; restart to change.
SUBSCRIPTIONS_ENABLED=false
WEBHOOK_ENABLED=false
INGRESS_MAX_ATTEMPTS=8
INGRESS_MAX_PENDING=10000
# Inject secrets via your deployment's secure mechanism. MCP_BEARER_TOKEN must
# differ from BOTH Zulip credentials. Use the actual Zulip-provided values.
ZULIP_API_KEY=
MCP_BEARER_TOKEN=
ZULIP_WEBHOOK_TOKEN=
